rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Validation Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(val) {
      return val is timestamp;
    }

    // --- Entity Validation Blueprints ---
    function isValidCountry(data) {
      return data.keys().hasAll([
          'countryId', 'name', 'code', 'keywords', 'flagMode',
          'flagDataUrl', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'countryId', 'name', 'code', 'keywords', 'flagMode',
          'flagDataUrl', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.countryId) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.code is string && data.code.size() <= 10 && data.code.matches('^([A-Z]{2}(-[A-Z]{2,3})?)?$') &&
        data.keywords is string && data.keywords.size() <= 200 &&
        data.flagMode in ['preset', 'upload'] &&
        data.flagDataUrl is string && data.flagDataUrl.size() <= 120000 &&
        data.isActive is bool &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidVpnServer(data) {
      return data.keys().hasAll([
          'countryName', 'countryCode', 'flagMode', 'flagDataUrl',
          'ipAddress', 'ipCode', 'status', 'username', 'password',
          'notes', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'countryName', 'countryCode', 'flagMode', 'flagDataUrl',
          'ipAddress', 'ipCode', 'status', 'username', 'password',
          'notes', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.countryName is string && data.countryName.size() >= 2 && data.countryName.size() <= 80 &&
        data.countryCode is string && data.countryCode.size() <= 10 && data.countryCode.matches('^([A-Z]{2}(-[A-Z]{2,3})?)?$') &&
        data.flagMode in ['preset', 'upload'] &&
        data.flagDataUrl is string && data.flagDataUrl.size() <= 120000 &&
        data.ipAddress is string && data.ipAddress.size() >= 3 && data.ipAddress.size() <= 64 && data.ipAddress.matches('^[a-zA-Z0-9.:\\-]+$') &&
        data.ipCode is string && data.ipCode.size() >= 1 && data.ipCode.size() <= 64 && data.ipCode.matches('^[a-zA-Z0-9_.:/\\-]+$') &&
        data.status in ['Active', 'Inactive'] &&
        data.username is string && data.username.size() <= 100 &&
        data.password is string && data.password.size() <= 100 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidIpCode(data) {
      return data.keys().hasAll([
          'codeId', 'code', 'label', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'codeId', 'code', 'label', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.codeId) &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 64 && data.code.matches('^[a-zA-Z0-9_.:/\\-]+$') &&
        data.label is string && data.label.size() <= 100 &&
        data.status in ['Active', 'Inactive'] &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidRedeemCode(data) {
      return data.keys().hasAll([
          'codeId', 'code', 'balance', 'status', 'expiryDate',
          'redemptionStatus', 'redeemedAt', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'codeId', 'code', 'label', 'balance', 'status', 'expiryDate',
          'expiresAt', 'redemptionStatus', 'redeemedAt', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.codeId) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 64 && data.code.matches('^[a-zA-Z0-9_\\-]+$') &&
        (!('label' in data) || (data.label is string && data.label.size() <= 100)) &&
        (data.balance is int || data.balance is float) && data.balance >= 0 && data.balance <= 10000000 &&
        data.status in ['Active', 'Inactive'] &&
        data.expiryDate is string && data.expiryDate.size() <= 32 && data.expiryDate.matches('^(\\d{4}-\\d{2}-\\d{2})?$') &&
        (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp) &&
        data.redemptionStatus in ['Unused', 'Redeemed'] &&
        data.redeemedAt is string && data.redeemedAt.size() <= 64 &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidConnectionRequest(data) {
      return data.keys().hasAll([
          'requestId', 'countryName', 'countryCode', 'ipAddress',
          'redeemCodeId', 'redeemCode', 'ipCodeId', 'ipCode',
          'balance', 'resultStatus', 'statusReason', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'requestId', 'countryName', 'countryCode', 'ipAddress',
          'redeemCodeId', 'redeemCode', 'ipCodeId', 'ipCode',
          'balance', 'resultStatus', 'statusReason', 'createdAt'
        ]) &&
        isValidId(data.requestId) &&
        data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 80 &&
        data.countryCode is string && data.countryCode.size() <= 10 &&
        data.ipAddress is string && data.ipAddress.size() >= 3 && data.ipAddress.size() <= 64 && data.ipAddress.matches('^[a-zA-Z0-9.:\\-]+$') &&
        isValidId(data.redeemCodeId) &&
        data.redeemCode is string && data.redeemCode.size() >= 1 && data.redeemCode.size() <= 64 &&
        isValidId(data.ipCodeId) &&
        data.ipCode is string && data.ipCode.size() >= 1 && data.ipCode.size() <= 64 &&
        (data.balance is int || data.balance is float) && data.balance >= 0 && data.balance <= 10000000 &&
        data.resultStatus in ['Connected', 'Rejected'] &&
        data.statusReason is string && data.statusReason.size() <= 240 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly([
          'uid', 'email', 'adminId', 'displayName', 'role', 'isActive',
          'addedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('adminId' in data) || (data.adminId is string && data.adminId.size() <= 64)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 80)) &&
        (!('role' in data) || data.role in ['Admin', 'SuperAdmin']) &&
        (!('isActive' in data) || data.isActive is bool) &&
        data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidAdminIdMapping(data) {
      return data.keys().hasAll([
          'idKey', 'adminId', 'authEmail', 'uid', 'displayName',
          'isActive', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'idKey', 'adminId', 'authEmail', 'uid', 'displayName',
          'isActive', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        data.idKey is string && data.idKey.size() >= 2 && data.idKey.size() <= 64 && data.idKey.matches('^[a-z0-9_\\-]+$') &&
        data.adminId is string && data.adminId.size() >= 2 && data.adminId.size() <= 64 && data.adminId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authEmail is string && data.authEmail.size() >= 3 && data.authEmail.size() <= 160 &&
        data.uid is string && data.uid.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 80 &&
        data.isActive is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---

    match /countries/{countryId} {
      allow get: if isValidId(countryId);
      allow list: if resource.data.isActive in [true, false];
      allow create: if isValidId(countryId) &&
        isValidCountry(incoming()) &&
        incoming().countryId == countryId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(countryId) &&
        isValidCountry(incoming()) &&
        incoming().countryId == existing().countryId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'code', 'keywords', 'flagMode', 'flagDataUrl', 'isActive', 'updatedAt'
        ]);
      allow delete: if isValidId(countryId);
    }

    match /vpn_servers/{serverId} {
      allow get: if isValidId(serverId);
      allow list: if resource.data.status in ['Active', 'Inactive'];
      allow create: if isValidId(serverId) &&
        isValidVpnServer(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(serverId) &&
        isValidVpnServer(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'countryName', 'countryCode', 'flagMode', 'flagDataUrl',
          'ipAddress', 'ipCode', 'status', 'username', 'password', 'notes', 'updatedAt'
        ]);
      allow delete: if isValidId(serverId);
    }

    match /ip_codes/{ipCodeId} {
      allow get: if isValidId(ipCodeId);
      allow list: if resource.data.status in ['Active', 'Inactive'];
      allow create: if isValidId(ipCodeId) &&
        isValidIpCode(incoming()) &&
        incoming().codeId == ipCodeId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(ipCodeId) &&
        isValidIpCode(incoming()) &&
        incoming().codeId == existing().codeId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'code', 'label', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(ipCodeId);
    }

    match /redeem_codes/{codeId} {
      allow get: if isValidId(codeId);
      allow list: if resource.data.status in ['Active', 'Inactive'];
      allow create: if isValidId(codeId) &&
        isValidRedeemCode(incoming()) &&
        incoming().codeId == codeId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(codeId) &&
        isValidRedeemCode(incoming()) &&
        incoming().codeId == existing().codeId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // User Portal Atomic One-Time Redemption
          (
            existing().status == 'Active' &&
            existing().redemptionStatus == 'Unused' &&
            incoming().redemptionStatus == 'Redeemed' &&
            (existing().expiryDate == '' || !('expiresAt' in existing()) || existing().expiresAt == null || existing().expiresAt >= request.time) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'redemptionStatus', 'redeemedAt', 'updatedAt'
            ])
          ) ||
          // Admin Panel Edits (balance, status, expiry, redemption reset, label)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'label', 'balance', 'status', 'expiryDate', 'expiresAt',
            'redemptionStatus', 'redeemedAt', 'updatedAt'
          ])
        );
      allow delete: if isValidId(codeId);
    }

    match /connection_requests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if resource.data.resultStatus in ['Connected', 'Rejected'];
      allow create: if isValidId(requestId) &&
        isValidConnectionRequest(incoming()) &&
        incoming().requestId == requestId &&
        incoming().createdAt == request.time &&
        (
          (
            incoming().resultStatus == 'Rejected' &&
            incoming().balance == 0
          ) ||
          (
            incoming().resultStatus == 'Connected' &&
            exists(/databases/$(database)/documents/ip_codes/$(incoming().ipCodeId)) &&
            get(/databases/$(database)/documents/ip_codes/$(incoming().ipCodeId)).data.status == 'Active' &&
            existsAfter(/databases/$(database)/documents/redeem_codes/$(incoming().redeemCodeId)) &&
            getAfter(/databases/$(database)/documents/redeem_codes/$(incoming().redeemCodeId)).data.redemptionStatus == 'Redeemed' &&
            incoming().balance == get(/databases/$(database)/documents/redeem_codes/$(incoming().redeemCodeId)).data.balance
          )
        );
      allow update: if false;
      allow delete: if isValidId(requestId);
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid);
      allow list: if resource.data.uid >= '';
      allow create: if isValidId(adminUid) &&
        isValidAdminUser(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(adminUid) &&
        isValidAdminUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adminUid);
    }

    match /admin_ids/{adminIdKey} {
      allow get: if isValidId(adminIdKey);
      allow list: if resource.data.isActive in [true, false];
      allow create: if isValidId(adminIdKey) &&
        isValidAdminIdMapping(incoming()) &&
        incoming().idKey == adminIdKey &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(adminIdKey) &&
        isValidAdminIdMapping(incoming()) &&
        incoming().idKey == existing().idKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(adminIdKey);
    }
  }
}
